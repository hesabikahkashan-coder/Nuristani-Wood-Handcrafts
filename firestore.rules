rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Products collection permissions
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Handled strictly server-side
    }

    // Blog collection permissions
    match /blog/{postId} {
      allow read: if true;
      allow write: if false; // Handled strictly server-side
    }

    // Inquiries collection permissions
    match /inquiries/{inquiryId} {
      allow create: if true; // Contact forms can write directly
      allow read, update, delete: if false; // Accessed strictly server-side
    }

    // Orders collection permissions
    match /orders/{orderId} {
      allow create: if true; // Checkout page can submit orders
      allow read, update, delete: if false; // Managed strictly server-side
    }

    // Global settings document permissions
    match /settings/{settingId} {
      allow read: if true;
      allow write: if false; // Configured strictly by admin server proxy
    }
  }
}
